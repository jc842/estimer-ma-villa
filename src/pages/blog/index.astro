---
import Layout from '../../layouts/Layout.astro';
import { getCollection } from 'astro:content';

const posts = await getCollection('blog', ({ data }) => !data.draft && (!data.lang || data.lang === 'fr'));
posts.sort((a, b) => b.data.pubDate.valueOf() - a.data.pubDate.valueOf());
---

<Layout title="Tous les articles | Le Blog">
  <div class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8 py-12">
    <header class="mb-10 pb-6 border-b">
      <h1 class="text-3xl sm:text-4xl font-extrabold tracking-tight mb-2">Tous les articles</h1>
      <p class="text-stone-600 text-sm">Retrouvez l'ensemble de nos dossiers, guides et analyses.</p>
    </header>

    <div class="grid grid-cols-1 sm:grid-cols-2 lg:grid-cols-3 gap-6">
      {posts.map(post => (
        <article class="bg-white rounded-xl border p-5 shadow-sm hover:shadow-md transition-shadow flex flex-col">
          {post.data.heroImage && (
            <a href={`/blog/${post.id}`} class="aspect-[4/5] overflow-hidden rounded-lg mb-4 bg-stone-100">
              <img src={post.data.heroImage} alt={post.data.title} class="w-full h-full object-cover" loading="lazy" />
            </a>
          )}
          <span class="text-xs font-semibold uppercase text-stone-500 mb-2">{post.data.category}</span>
          <h3 class="text-base font-bold text-stone-900 hover:text-blue-600 transition-colors line-clamp-2 mb-2">
            <a href={`/blog/${post.id}`}>{post.data.title}</a>
          </h3>
          <p class="text-xs text-stone-600 line-clamp-3 mb-4 flex-grow">{post.data.description}</p>
          <div class="text-[11px] text-stone-400 pt-3 border-t">
            {new Date(post.data.pubDate).toLocaleDateString('fr-FR', { day: 'numeric', month: 'short', year: 'numeric' })}
          </div>
        </article>
      ))}
    </div>
  </div>
</Layout>
